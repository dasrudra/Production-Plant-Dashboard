# Browser origins allowed to call this API, comma separated.
#
# Add the machine's LAN address so other PCs on the plant network can use
# the dashboard, for example:
#   KPP_ALLOWED_ORIGINS=http://localhost:5173,http://10.206.15.144:5173
#
# No trailing slashes. Do not use "*" here: browsers reject a wildcard
# origin when allow_credentials is enabled.
KPP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173